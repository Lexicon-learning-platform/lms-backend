@Lms_backend_Api_HostAddress = http://localhost:5217
@baseUrl = {{Lms_backend_Api_HostAddress}}

# ---- Ids used throughout this file - replace with real values from your database ----
@userId = 44444444-0000-0000-0000-000000000001
@courseId = 11111111-0000-0000-0000-000000000001
@moduleId = 22222222-0000-0000-0000-000000000001
@activityId = 66666666-0000-0000-0000-000000000001
@resourceId = 55555555-0000-0000-0000-000000000001

# ---- Example credentials - replace with accounts that exist in your environment ----
# Only Admins can create other Admins/Teachers (via Admin - Register User below), and
# /api/auth/register only ever creates Students, so at least one Admin must already
# exist (e.g. seeded directly in the database) before the Admin/Teacher flows work.
@studentUsername = student1
@studentPassword = Password123!
@teacherUsername = teacher1
@teacherPassword = Password123!
@adminUsername = admin1
@adminPassword = Password123!

# =====================================================================
# AUTH  (AuthController - api/auth)
# =====================================================================

### Register - New Student (public self-registration)
# @name registerStudent
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "{{studentUsername}}",
  "password": "{{studentPassword}}"
}

### Login - Student
# @name loginStudent
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{studentUsername}}",
  "role": "Student",
  "password": "{{studentPassword}}"
}

@studentToken = {{loginStudent.response.body.$.accessToken}}

### Login - Teacher
# @name loginTeacher
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{teacherUsername}}",
  "role": "Teacher",
  "password": "{{teacherPassword}}"
}

@teacherToken = {{loginTeacher.response.body.$.accessToken}}

### Login - Admin
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{adminUsername}}",
  "role": "Admin",
  "password": "{{adminPassword}}"
}

@adminToken = {{loginAdmin.response.body.$.accessToken}}

### Refresh Access Token
# Reads the "refreshToken" HttpOnly cookie set by Login/Register - the REST Client
# cookie jar carries it automatically from whichever login request ran last.
# @name refreshToken
POST {{baseUrl}}/api/auth/token
Accept: application/json

### Logout
# Clears the "refreshToken" cookie for whichever account is currently logged in.
POST {{baseUrl}}/api/auth/logout
Accept: application/json


# =====================================================================
# ADMIN  (AdminController - api/admin) - all actions require role: Admin
# =====================================================================

### Admin - Register User (Teacher)
# @name adminRegisterTeacher
POST {{baseUrl}}/api/admin/register?role=Teacher
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "username": "{{teacherUsername}}",
  "password": "{{teacherPassword}}"
}

### Admin - Get All Users
GET {{baseUrl}}/api/admin/getusers
Authorization: Bearer {{adminToken}}
Accept: application/json

### Admin - Get User Statistics
GET {{baseUrl}}/api/admin/getuserstats/{{userId}}
Authorization: Bearer {{adminToken}}
Accept: application/json

### Admin - Update User
PUT {{baseUrl}}/api/admin/updateuser/{{userId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "username": "{{teacherUsername}}",
  "givenName": "Jane",
  "lastName": "Doe",
  "email": "jane.doe@example.com",
  "role": "Teacher"
}

### Admin - Reset User Password
# Note: the body is a raw JSON string, not an object.
PUT {{baseUrl}}/api/admin/resetpassword/{{userId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

"NewPassword123!"

### Admin - Disable User
PUT {{baseUrl}}/api/admin/disableuser/{{userId}}
Authorization: Bearer {{adminToken}}
Accept: application/json

### Admin - Enable User
PUT {{baseUrl}}/api/admin/enableuser/{{userId}}
Authorization: Bearer {{adminToken}}
Accept: application/json

### Admin - Add Course To User
PUT {{baseUrl}}/api/admin/addcoursetouser/{{userId}}/{{courseId}}
Authorization: Bearer {{adminToken}}
Accept: application/json

### Admin - Remove Course From User
PUT {{baseUrl}}/api/admin/removecoursefromuser/{{userId}}/{{courseId}}
Authorization: Bearer {{adminToken}}
Accept: application/json

### Admin - Delete User
DELETE {{baseUrl}}/api/admin/deleteuser/{{userId}}
Authorization: Bearer {{adminToken}}
Accept: application/json


# =====================================================================
# COURSES  (CourseController - api/courses)
# Reads are public except "my-course"; writes require role: Teacher or Admin
# =====================================================================

### Courses - Get My Course (current user)
GET {{baseUrl}}/api/courses/my-course
Authorization: Bearer {{studentToken}}
Accept: application/json

### Courses - Get All
GET {{baseUrl}}/api/courses?page=1&pageSize=20
Accept: application/json

### Courses - Get One
GET {{baseUrl}}/api/courses/{{courseId}}
Accept: application/json

### Courses - Create
# @name createCourse
POST {{baseUrl}}/api/courses
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "name": "Full-Stack C#",
  "description": "An introduction to full-stack development with C# and .NET.",
  "startDate": "2026-01-12",
  "duration": 10,
  "moduleIds": []
}

### Courses - Update
PUT {{baseUrl}}/api/courses/{{courseId}}
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "name": "Full-Stack C#",
  "description": "An introduction to full-stack development with C# and .NET.",
  "startDate": "2026-01-12",
  "duration": 12,
  "moduleIds": []
}

### Courses - Patch
PATCH {{baseUrl}}/api/courses/{{courseId}}
Authorization: Bearer {{teacherToken}}
Content-Type: application/json-patch+json

[
  { "op": "replace", "path": "/description", "value": "Updated course description." }
]

### Courses - Delete
DELETE {{baseUrl}}/api/courses/{{courseId}}
Authorization: Bearer {{teacherToken}}
Accept: application/json

### Courses - Get Resources
GET {{baseUrl}}/api/courses/{{courseId}}/resources
Authorization: Bearer {{studentToken}}
Accept: application/json

### Courses - Get Resource
GET {{baseUrl}}/api/courses/{{courseId}}/resources/{{resourceId}}
Authorization: Bearer {{studentToken}}
Accept: application/json

### Courses - Create Resource
POST {{baseUrl}}/api/courses/{{courseId}}/resources
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "name": "Syllabus",
  "description": "Course syllabus document.",
  "type": 1,
  "data": "https://example.com/syllabus.pdf"
}

### Courses - Attach Existing Resource
POST {{baseUrl}}/api/courses/{{courseId}}/resources/{{resourceId}}
Authorization: Bearer {{teacherToken}}
Accept: application/json

### Courses - Update Resource
PUT {{baseUrl}}/api/courses/{{courseId}}/resources/{{resourceId}}
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "name": "Syllabus",
  "description": "Updated course syllabus document.",
  "type": 1,
  "data": "https://example.com/syllabus-v2.pdf"
}

### Courses - Patch Resource
PATCH {{baseUrl}}/api/courses/{{courseId}}/resources/{{resourceId}}
Authorization: Bearer {{teacherToken}}
Content-Type: application/json-patch+json

[
  { "op": "replace", "path": "/description", "value": "Patched resource description." }
]

### Courses - Remove Resource
DELETE {{baseUrl}}/api/courses/{{courseId}}/resources/{{resourceId}}
Authorization: Bearer {{teacherToken}}
Accept: application/json


# =====================================================================
# MODULES  (ModulesController - api/modules)
# Reads require any authenticated user; writes require role: Teacher or Admin
